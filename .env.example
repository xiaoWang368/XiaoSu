# ====================
# LLM / Embedding (DashScope, OpenAI 兼容)
# ====================
# API 密钥(阿里云百炼 DashScope)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API 基础地址(DashScope 兼容模式)
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 默认 LLM 模型(可后台切换)
LLM_DEFAULT_MODEL=qwen-plus
# 温度(越低越稳定)
LLM_DEFAULT_TEMPERATURE=0.1
# 嵌入模型与维度
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ====================
# PostgreSQL(文本元数据:documents / chunks / chat_logs / settings)
# ====================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=xiaosu
POSTGRES_PASSWORD=xiaosu_dev_pw
POSTGRES_DB=xiaosu

# ====================
# MinIO(原始文件存储:PDF/docx/md/txt)
# ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=xiaosu
MINIO_SECRET_KEY=xiaosu_dev_pw
MINIO_BUCKET_NAME=xiaosu-files
MINIO_IMG_DIR=kb01
MINIO_SECURE=false

# ====================
# Chroma(向量库,进程内落盘)
# ====================
VECTOR_STORE=chroma        # chroma | numpy(兜底)
CHROMA_PATH=data/chroma

# ====================
# 钉钉(Stream 模式机器人)
# ====================
DINGTALK_APP_KEY=xxxxxxxxxxxxxxxxxxxx
DINGTALK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================
# MinerU 在线解析 API(PDF / Word → Markdown)
# ====================
MINERU_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_BASE_URL=https://mineru.net/api/v4

# ====================
# 本地上传备份目录(项目外的其他磁盘;上传时原文件备份到这里)
# ====================
LOCAL_UPLOAD_DIR="F:\xiaosu_uploads"

# ====================
# 服务与路径
# ====================
BACKEND_PORT=8000
MOCK_PORT=8001
LOG_DIR=logs
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
